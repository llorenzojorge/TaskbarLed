<!--
  The panel's look: session tabs, vertical feed, timer and context, LED dot overlay and edit chrome.
  Hosted by PanelWindow on the taskbar and by DemoRenderer for README screenshots.
  Colors and fonts come from the active theme (Themes/*.xaml) through DynamicResource.
-->
<UserControl x:Class="TaskbarLed.App.Panels.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TaskbarLed.App.Presentation"
             xmlns:panels="clr-namespace:TaskbarLed.App.Panels"
             xmlns:s="clr-namespace:TaskbarLed.Core.Sessions;assembly=TaskbarLed.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PanelViewModel}"
             d:DesignWidth="420" d:DesignHeight="36"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Hard on/off blink, like a real LED. 10 fps is plenty for a step animation. -->
    <Storyboard x:Key="Blink" RepeatBehavior="Forever" Timeline.DesiredFrameRate="10">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0.15" />
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Lines of the vertical feed are created in code with this style. -->
    <Style x:Key="FeedText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Led.FontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedStatus}" Value="{x:Static s:SessionStatus.AwaitingInput}">
          <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsEditing}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Led.EditBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Compact flat buttons for edit mode. -->
    <Style x:Key="EditButton" TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="9,2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Outline that blinks while a finished session waits to be seen. -->
    <Style x:Key="Halo" TargetType="Rectangle">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Stroke" Value="{DynamicResource Led.DoneBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBlinking}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="HaloBlink" Storyboard="{StaticResource Blink}" />
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="HaloBlink" />
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
          <Setter Property="Stroke" Value="{DynamicResource Led.AttentionBrush}" />
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="HaloAttention" Storyboard="{StaticResource Blink}" />
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="HaloAttention" />
          </DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A session tab: "1 WEBAPP ▸". The tab shown in the feed gets a lit outline; status sets color and blinking. -->
    <DataTemplate x:Key="SessionTab" DataType="{x:Type vm:ChannelViewModel}">
      <Border x:Name="Tab" Margin="0,0,3,0" Padding="3,0" CornerRadius="2" BorderThickness="1" BorderBrush="Transparent"
              Background="{DynamicResource Led.ChannelOffBrush}">
        <!-- The status mark stays whole; the title gives way ("1 Bug visual da…") when the row is full. -->
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Right" Margin="4,0,0,0" Text="{Binding Glyph, Mode=OneWay}"
                     FontFamily="{Binding FontFamily, ElementName=TabText}" FontSize="{Binding FontSize, ElementName=TabText}"
                     FontWeight="{Binding FontWeight, ElementName=TabText}" Foreground="{Binding Foreground, ElementName=TabText}" />
          <TextBlock x:Name="TabText" Text="{Binding Label, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                     FontFamily="{DynamicResource Led.FontFamily}" FontSize="10.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource Led.DimBrush}" />
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static s:SessionStatus.Running}">
          <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
        </DataTrigger>
        <!-- Finished: steady green. The panel's halo does the blinking; blinking tabs too was noise. -->
        <DataTrigger Binding="{Binding Status}" Value="{x:Static s:SessionStatus.Completed}">
          <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource Led.DoneBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static s:SessionStatus.AwaitingInput}">
          <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="TabAttention">
              <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="10">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Tab" Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                  <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                  <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0.25" />
                </DoubleAnimationUsingKeyFrames>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="TabAttention" />
          </DataTrigger.ExitActions>
        </DataTrigger>
        <!-- Selected tab: lit outline, bold text. Declared last so it wins over status colors.
             An outline keeps small text readable, where a filled tab would not be. -->
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Led.ForegroundBrush}" />
          <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
          <Setter TargetName="TabText" Property="FontWeight" Value="Bold" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsSelected}" Value="True" />
            <Condition Binding="{Binding Status}" Value="{x:Static s:SessionStatus.AwaitingInput}" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Led.AttentionBrush}" />
          <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
        </MultiDataTrigger>
        <!-- Selected and finished: keep the green, and outline it in green, so the selection does not turn it white. -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsSelected}" Value="True" />
            <Condition Binding="{Binding Status}" Value="{x:Static s:SessionStatus.Completed}" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Led.DoneBrush}" />
          <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource Led.DoneBrush}" />
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="Root" Cursor="Hand">
    <Border x:Name="Surface" CornerRadius="4"
            Background="{DynamicResource Led.BackgroundBrush}"
            BorderBrush="{DynamicResource Led.BorderBrush}"
            BorderThickness="1" />

    <Grid Margin="12,0"
          Visibility="{Binding ShowActivitySummary, RelativeSource={RelativeSource AncestorType=panels:PanelView}, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Source="/Assets/TaskbarLedMark.png" Width="19" Height="19" VerticalAlignment="Center" HorizontalAlignment="Left" />
      <Border Grid.Column="1" MinWidth="39" CornerRadius="8" Padding="5,2" VerticalAlignment="Center"
              Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
              TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="▸" FontSize="12" Margin="0,0,4,0" />
          <TextBlock Text="{Binding ActiveCount}" FontSize="12" FontWeight="SemiBold"
                     FontFamily="{DynamicResource Led.FontFamily}" />
        </StackPanel>
      </Border>
    </Grid>
    <ScrollViewer Margin="8,5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding ShowSessionRows, RelativeSource={RelativeSource AncestorType=panels:PanelView}, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <Border CornerRadius="3" Margin="0,0,0,4">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLineMap}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Led.BrandHeaderBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal" Margin="4,2">
            <Image Source="/Assets/TaskbarLedMark.png" Width="17" Height="17" Margin="0,0,6,0" />
            <TextBlock Text="TaskbarLed" FontWeight="SemiBold" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLineMap}" Value="True">
                      <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:SessionListRow}">
              <Grid Height="23">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Background" Value="{DynamicResource Led.ChannelOffBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsChild}" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Margin" Value="12,0,0,0" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsDone}" Value="True">
                        <Setter Property="Background" Value="#55BFE6C8" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                  <Border DockPanel.Dock="Left" Width="22" Height="17" Margin="2,0,3,0" CornerRadius="3"
                          Background="{Binding RouteColor}"
                          Visibility="{Binding DataContext.IsLineMap, RelativeSource={RelativeSource AncestorType=panels:PanelView}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding RouteLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" Foreground="White" />
                  </Border>
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="5,0"
                             VerticalAlignment="Center" Foreground="{DynamicResource Led.ForegroundBrush}" />
                </DockPanel>
                <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="5,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Led.ForegroundBrush}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Grid Margin="6,3,8,2" Visibility="{Binding ShowCompactTicker, RelativeSource={RelativeSource AncestorType=panels:PanelView}, Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ItemsControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource SessionTab}"
                    ClipToBounds="True" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <panels:TabStripPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Grid Grid.Row="1" Grid.Column="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

      <!-- Optional prompt / spinner glyph before the feed (Led.FeedPrefix); it pulses while running. -->
      <TextBlock x:Name="FeedPrefix" Grid.Column="0" VerticalAlignment="Center"
                 Text="{DynamicResource Led.FeedPrefix}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource FeedText}">
            <Setter Property="Foreground" Value="{DynamicResource Led.AccentBrush}" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Style.Triggers>
              <!-- Themes without a glyph keep the feed exactly where it was. -->
              <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </Trigger>
              <DataTrigger Binding="{Binding SelectedStatus}" Value="{x:Static s:SessionStatus.Running}">
                <DataTrigger.EnterActions>
                  <BeginStoryboard x:Name="PrefixPulse">
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.8" />
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <RemoveStoryboard BeginStoryboardName="PrefixPulse" />
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <!-- Vertical feed: each new line drops in from the top and types itself out. -->
      <Canvas x:Name="FeedHost" Grid.Column="1" ClipToBounds="True">
        <Canvas.Style>
          <Style TargetType="Canvas">
            <Style.Triggers>
              <!-- Leave room for the Save / Cancel buttons. -->
              <DataTrigger Binding="{Binding IsEditing}" Value="True">
                <Setter Property="Margin" Value="0,0,140,0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Canvas.Style>
        <Canvas.Effect>
          <DropShadowEffect Color="{DynamicResource Led.GlowColor}" BlurRadius="8" ShadowDepth="0" Opacity="{DynamicResource Led.GlowOpacity}" />
        </Canvas.Effect>
      </Canvas>
      </Grid>

      <!-- LED dots only over the feed's large text; small tab labels stay crisp. -->
      <Rectangle Grid.Row="1" Grid.Column="0" Fill="{DynamicResource Led.DotGridBrush}" IsHitTestVisible="False" />

      <!-- Prompt timer on the feed's line, so the tabs get the whole top row for chat titles. -->
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElapsedText}" VerticalAlignment="Center" Margin="10,0,0,0"
                 FontFamily="{DynamicResource Led.FontFamily}" FontSize="12" FontWeight="SemiBold"
                 Foreground="{DynamicResource Led.ForegroundBrush}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsEditing}" Value="True">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <Rectangle Style="{StaticResource Halo}" RadiusX="4" RadiusY="4" StrokeThickness="1.5" IsHitTestVisible="False" />

    <!-- Edit mode: dashed outline and a resize handle on the right edge. -->
    <Rectangle Stroke="{DynamicResource Led.EditBrush}" StrokeThickness="1" StrokeDashArray="3 2" RadiusX="4" RadiusY="4"
               IsHitTestVisible="False" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
    <!-- Always-visible way out of edit mode: closing the menu must never leave the panel stuck editing. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <Button x:Name="SaveButton" Content="{Binding SaveLabel}" Style="{StaticResource EditButton}" Margin="0,0,4,0"
              Background="{DynamicResource Led.EditBrush}" Foreground="#FF111111" Click="OnSaveClick" />
      <Button x:Name="CancelButton" Content="{Binding CancelLabel}" Style="{StaticResource EditButton}"
              Background="{DynamicResource Led.ChannelOffBrush}" Foreground="{DynamicResource Led.ForegroundBrush}" Click="OnCancelClick" />
    </StackPanel>
    <Rectangle x:Name="ResizeGrip" x:FieldModifier="public" Width="10" HorizontalAlignment="Right" Fill="#01000000" Cursor="SizeWE"
               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
