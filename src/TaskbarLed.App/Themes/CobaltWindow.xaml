<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="Led.BackgroundBrush" Color="#DDE5F2" />
  <SolidColorBrush x:Key="Led.BorderBrush" Color="#101F58" />
  <SolidColorBrush x:Key="Led.ForegroundBrush" Color="#182848" />
  <SolidColorBrush x:Key="Led.DimBrush" Color="#3D507F" />
  <SolidColorBrush x:Key="Led.AttentionBrush" Color="#81451E" />
  <SolidColorBrush x:Key="Led.DoneBrush" Color="#285E54" />
  <SolidColorBrush x:Key="Led.ChannelOffBrush" Color="#C6D3EC" />
  <SolidColorBrush x:Key="Led.EditBrush" Color="#2D46A8" />
  <SolidColorBrush x:Key="Led.AccentBrush" Color="#2D46A8" />
  <SolidColorBrush x:Key="Led.DotGridBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionTitleBrush" Color="#FFFDF7" />
  <SolidColorBrush x:Key="Led.SessionRunningBrush" Color="#2D46A8" />
  <SolidColorBrush x:Key="Led.SessionHeaderStatusBrush" Color="#E8F0FF" />
  <SolidColorBrush x:Key="Led.SessionNodeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionHeaderBrush" Color="#253E9D" />
  <SolidColorBrush x:Key="Led.SessionRailBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionTreeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionChildBrush" Color="#F1F4FC" />
  <SolidColorBrush x:Key="Led.SessionStatusBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionDividerBrush" Color="#CBD6E8" />
  <Color x:Key="Led.GlowColor">Transparent</Color>
  <sys:Double x:Key="Led.GlowOpacity">0</sys:Double>
  <x:Static x:Key="Led.FeedPrefix" Member="sys:String.Empty" />
  <FontFamily x:Key="Led.FontFamily">Helvetica Neue, Consolas, Courier New</FontFamily>
  <sys:Double x:Key="Led.PanelRadius">2</sys:Double>
  <SolidColorBrush x:Key="Led.SessionHeaderWaitingBrush" Color="#FFE3A7" />
</ResourceDictionary>
