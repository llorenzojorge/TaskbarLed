<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="Led.BackgroundBrush" Color="#101117" />
  <SolidColorBrush x:Key="Led.BorderBrush" Color="#292B39" />
  <SolidColorBrush x:Key="Led.ForegroundBrush" Color="#F2F2FA" />
  <SolidColorBrush x:Key="Led.DimBrush" Color="#A8A9BC" />
  <SolidColorBrush x:Key="Led.AttentionBrush" Color="#F2CB74" />
  <SolidColorBrush x:Key="Led.DoneBrush" Color="#9DD6AF" />
  <SolidColorBrush x:Key="Led.ChannelOffBrush" Color="#1C1D2A" />
  <SolidColorBrush x:Key="Led.EditBrush" Color="#EE83BE" />
  <SolidColorBrush x:Key="Led.AccentBrush" Color="#EE83BE" />
  <SolidColorBrush x:Key="Led.DotGridBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionTitleBrush" Color="#F5F2FA" />
  <SolidColorBrush x:Key="Led.SessionRunningBrush" Color="#EE83BE" />
  <SolidColorBrush x:Key="Led.SessionHeaderStatusBrush" Color="#EE83BE" />
  <SolidColorBrush x:Key="Led.SessionNodeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionHeaderBrush" Color="#1C1D2A" />
  <SolidColorBrush x:Key="Led.SessionRailBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionTreeBrush" Color="#45405D" />
  <SolidColorBrush x:Key="Led.SessionChildBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionStatusBrush" Color="Transparent" />
  <SolidColorBrush x:Key="Led.SessionDividerBrush" Color="#2D2E3C" />
  <Color x:Key="Led.GlowColor">Transparent</Color>
  <sys:Double x:Key="Led.GlowOpacity">0</sys:Double>
  <x:Static x:Key="Led.FeedPrefix" Member="sys:String.Empty" />
  <FontFamily x:Key="Led.FontFamily">Inter, Segoe UI, Arial</FontFamily>
  <sys:Double x:Key="Led.PanelRadius">10</sys:Double>
</ResourceDictionary>
