<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Description>Windows integration: windows, monitors, taskbar, full-screen detection, auto-start and hook IPC.</Description>
    <!-- Required by LibraryImport source-generated P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI Automation (TaskbarButtonWatcher): Windows 11 taskbar buttons have no windows of their own. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <ProjectReference Include="..\TaskbarLed.Core\TaskbarLed.Core.csproj" />
  </ItemGroup>

</Project>
