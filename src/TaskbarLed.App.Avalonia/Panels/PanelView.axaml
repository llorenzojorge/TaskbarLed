<!--
  The panel's look on Avalonia: session tabs, feed line and timer, blinking outline.
  Mirrors src/TaskbarLed.App/Panels/PanelView.xaml (WPF). Colors come from the Led.* resources.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:TaskbarLed.App.Avalonia"
             xmlns:vm="using:TaskbarLed.App.Avalonia.Presentation"
             xmlns:panels="using:TaskbarLed.App.Avalonia.Panels"
             x:Class="TaskbarLed.App.Avalonia.Panels.PanelView"
             x:DataType="vm:PanelViewModel">

  <UserControl.Styles>
    <!-- Hard on/off blink, like a real LED. -->
    <Style Selector=":is(Control).blink:not(.glass)">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="49%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Border.session-completion.blink.glass">
      <Style.Animations>
        <Animation Duration="0:0:1.5" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Border.session-row.cobalt">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBlock.editorial-engine">
      <Setter Property="Foreground" Value="{DynamicResource Led.SessionRailBrush}" />
    </Style>

    <Style Selector="Border.session-row">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.session-row.header">
      <Setter Property="Background" Value="{DynamicResource Led.SessionHeaderBrush}" />
    </Style>
    <Style Selector="TextBlock.session-label">
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
    </Style>
    <Style Selector="Border.session-row.header TextBlock.session-label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Led.SessionTitleBrush}" />
    </Style>
    <Style Selector="Border.session-row.child">
      <Setter Property="Background" Value="{DynamicResource Led.SessionChildBrush}" />
    </Style>
    <Style Selector="Border.session-row.child TextBlock.session-label">
      <Setter Property="Margin" Value="9,0,8,0" />
    </Style>
    <Style Selector="TextBlock.session-status">
      <Setter Property="Foreground" Value="{DynamicResource Led.SessionRunningBrush}" />
    </Style>
    <Style Selector="Border.session-row.header TextBlock.session-status">
      <Setter Property="Foreground" Value="{DynamicResource Led.SessionHeaderStatusBrush}" />
    </Style>
    <Style Selector="TextBlock.session-status.idle">
      <Setter Property="Foreground" Value="{DynamicResource Led.DimBrush}" />
    </Style>
    <Style Selector="TextBlock.session-status.waiting">
      <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>
    <Style Selector="Border.cobalt.header TextBlock.session-status">
      <Setter Property="Foreground" Value="{DynamicResource Led.SessionHeaderStatusBrush}" />
    </Style>
    <Style Selector="Border.cobalt.header TextBlock.session-status.waiting">
      <Setter Property="Foreground" Value="{DynamicResource Led.SessionHeaderWaitingBrush}" />
    </Style>
    <Style Selector="Border.session-completion">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.session-completion.blink">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Border.tab">
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="Padding" Value="3,0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="{DynamicResource Led.ChannelOffBrush}" />
    </Style>
    <Style Selector="Border.tab TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Led.FontFamily}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Led.DimBrush}" />
    </Style>
    <Style Selector="Border.tab.running TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
    </Style>
    <Style Selector="Border.tab.completed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.DoneBrush}" />
    </Style>
    <Style Selector="Border.tab.awaiting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>
    <!-- Selected tab: lit outline, bold text. Declared after the status colors so it wins. -->
    <Style Selector="Border.tab.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Led.ForegroundBrush}" />
    </Style>
    <Style Selector="Border.tab.selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.tab.selected.awaiting">
      <Setter Property="BorderBrush" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>
    <Style Selector="Border.tab.selected.awaiting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>

    <Style Selector="TextBlock.feed">
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.feed.attention">
      <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>

    <Style Selector="Border.halo">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Led.CompletionBrush}" />
    </Style>
    <Style Selector="Border.halo.attention">
      <Setter Property="BorderBrush" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>
    <Style Selector="Border.island-surface">
      <Setter Property="CornerRadius" Value="{DynamicResource Led.PanelRadius}" />
      <Setter Property="BorderThickness" Value="{DynamicResource Led.FrameThickness}" />
    </Style>
    <Style Selector="UserControl.dynamic-island Border.island-surface">
      <Setter Property="CornerRadius" Value="0,0,20,20" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Border Classes="island-surface" Opacity="{Binding PanelOpacity}" IsHitTestVisible="False"
            Background="{DynamicResource Led.PanelSurfaceBrush}" BorderBrush="{DynamicResource Led.BorderBrush}" />
    <Border Name="PanelFrame" Classes="island-surface"
            Padding="{DynamicResource Led.PanelPadding}">

      <Grid Name="PanelContent" Margin="{Binding IslandContentMargin}" IsVisible="{Binding ShowPanelContent}" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*,Auto">
        <Grid Name="PanelBrand" Grid.ColumnSpan="2" Height="26" Margin="0,0,0,3" IsVisible="{Binding !IslandMode}">
          <Border IsVisible="{Binding ShowLineMap}" Background="{DynamicResource Led.BrandHeaderBrush}" CornerRadius="4,4,0,0" />
          <Border HorizontalAlignment="Left" VerticalAlignment="Center" Padding="7,2"
                  CornerRadius="8" Background="{DynamicResource Led.BrandBackdropBrush}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Source="/Assets/TaskbarLedMark.png" Width="17" Height="17" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static app:App.DisplayName}" VerticalAlignment="Center" IsVisible="{Binding !ShowLineMap}"
                       Foreground="{DynamicResource Led.ForegroundBrush}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static app:App.DisplayName}" VerticalAlignment="Center" IsVisible="{Binding ShowLineMap}"
                       Foreground="White" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
          </Border>
        </Grid>
        <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Channels}" IsVisible="{Binding !HasSubagents}" ClipToBounds="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <panels:TabStripPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChannelViewModel">
              <Border Classes="tab"
                      Classes.running="{Binding IsRunning}"
                      Classes.completed="{Binding IsCompleted}"
                      Classes.awaiting="{Binding IsAwaiting}"
                      Classes.selected="{Binding IsSelected}"
                      Classes.blink="{Binding IsCompleted}">
                <!-- The status mark stays whole; the title gives way when the row is full. -->
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Margin="4,0,0,0" Text="{Binding Glyph}" />
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Grid.Row="2" Grid.Column="0" LastChildFill="True" IsVisible="{Binding !HasSubagents}">
          <TextBlock DockPanel.Dock="Left" Classes.pulse="{Binding FeedIsRunning}" Text="{DynamicResource Led.FeedPrefix}" Foreground="{DynamicResource Led.AccentBrush}"
                     VerticalAlignment="Center" FontSize="14" FontFamily="{DynamicResource Led.FontFamily}" />
          <TextBlock Margin="3,0,0,0" Classes="feed" Classes.attention="{Binding FeedIsAttention}"
                   Text="{Binding Feed}" VerticalAlignment="Center"
                   FontFamily="{DynamicResource Led.FontFamily}" FontSize="13" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis">
          <TextBlock.Effect>
            <DropShadowEffect Color="{DynamicResource Led.GlowColor}" BlurRadius="8" OffsetX="0" OffsetY="0" Opacity="{DynamicResource Led.GlowOpacity}" />
          </TextBlock.Effect>
          </TextBlock>
        </DockPanel>

        <!-- Prompt timer on the feed's line, so the tabs get the whole top row for chat titles. -->
        <TextBlock Grid.Row="2" Grid.Column="1" IsVisible="{Binding !HasSubagents}" Text="{Binding ElapsedText}" VerticalAlignment="Center" Margin="10,0,0,0"
                   FontFamily="{DynamicResource Led.FontFamily}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource Led.ForegroundBrush}" />
        <ScrollViewer Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding ShowSessionList}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SessionRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionDisplayRowViewModel">
                <Border Classes="session-row" Classes.header="{Binding IsHeader}" Classes.child="{Binding IsChild}" Classes.cobalt="{Binding IsCobalt}">
                  <Grid>
                    <Border Classes="session-completion" Classes.blink="{Binding IsDone}" Classes.glass="{Binding IsLiquidGlass}"
                            Background="{DynamicResource Led.CompletionTint}"
                            BorderBrush="{DynamicResource Led.CompletionBrush}" BorderThickness="1"
                            CornerRadius="3" IsHitTestVisible="False" />
                    <Border BorderBrush="{DynamicResource Led.SessionDividerBrush}" BorderThickness="0,0,0,1"
                            IsHitTestVisible="False" />
                    <Grid ColumnDefinitions="6,Auto,*,Auto" Margin="5,0,8,0" IsVisible="{Binding !IsLineMap}">
                    <Border Grid.Column="0" IsVisible="{Binding IsHeader}" Width="3" Margin="0,3,2,3"
                            Background="{DynamicResource Led.SessionRailBrush}" CornerRadius="1" />
                    <Border Grid.Column="1" IsVisible="{Binding IsChild}" Width="1" Margin="6,0,0,0"
                            Background="{DynamicResource Led.SessionTreeBrush}" />
                    <Ellipse Grid.Column="1" IsVisible="{Binding IsChild}" Width="6" Height="6" Margin="3,0,-2,0"
                             VerticalAlignment="Center" Fill="{DynamicResource Led.SessionNodeBrush}" />
                    <TextBlock Grid.Column="2" Classes="session-label" Text="{Binding CompactLabel}" ToolTip.Tip="{Binding Label}"
                               IsVisible="{Binding !HasSplitHeader}" FontFamily="{DynamicResource Led.FontFamily}"
                               VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <Grid Grid.Column="2" ColumnDefinitions="Auto,*" IsVisible="{Binding ShowEditorialHeader}">
                        <TextBlock Classes="editorial-engine" Text="{Binding EngineLabel}" FontFamily="Helvetica Neue"
                                   FontWeight="Bold" FontSize="9" Width="92" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding EditorialHeading}" Foreground="{DynamicResource Led.SessionTitleBrush}"
                                   FontFamily="Georgia" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                      </Grid>
                      <Grid Grid.Column="2" ColumnDefinitions="*,Auto" IsVisible="{Binding ShowVioletHeader}">
                        <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource Led.SessionTitleBrush}"
                                   FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding EngineLabel}" Foreground="{DynamicResource Led.DimBrush}"
                                   FontFamily="Menlo" FontSize="9" Margin="8,0,6,0" VerticalAlignment="Center" />
                      </Grid>
                      <Border Grid.Column="3" Background="{DynamicResource Led.SessionStatusBrush}" CornerRadius="3"
                              VerticalAlignment="Center" Padding="4,1" Margin="2,0,0,0">
                        <TextBlock Classes="session-status" Classes.waiting="{Binding IsWaiting}" Classes.idle="{Binding IsIdle}"
                                   Text="{Binding Status}" FontFamily="{DynamicResource Led.FontFamily}" FontSize="10.5" />
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="29,*,Auto" Margin="5,0,8,0" IsVisible="{Binding IsLineMap}">
                      <Border Grid.ColumnSpan="3" Height="1" Background="{DynamicResource Led.RouteDividerBrush}" IsVisible="{Binding Row.LastStation}"
                              VerticalAlignment="Bottom" IsHitTestVisible="False" />
                      <Grid Grid.Column="0" RowDefinitions="*,*">
                        <Border Grid.Row="0" Width="2" IsVisible="{Binding IsChild}"
                                Background="{Binding LineBrush}" HorizontalAlignment="Center" />
                        <Border Grid.Row="1" Width="2" IsVisible="{Binding ConnectToNext}"
                                Background="{Binding LineBrush}" HorizontalAlignment="Center" />
                        <Border Grid.RowSpan="2" Width="18" Height="17" CornerRadius="3"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding IsHeader}" Background="{Binding LineBrush}">
                          <TextBlock Text="{Binding LineLetter}" Foreground="White" FontSize="11" FontWeight="Bold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Grid Grid.RowSpan="2" IsVisible="{Binding IsChild}" VerticalAlignment="Center" Height="12">
                          <Border Width="9" Height="2" HorizontalAlignment="Center" Margin="12,0,0,0"
                                  VerticalAlignment="Center" Background="{Binding LineBrush}" />
                          <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Fill="{DynamicResource Led.BackgroundBrush}" Stroke="{Binding LineBrush}" StrokeThickness="1.5" />
                        </Grid>
                      </Grid>
                      <TextBlock Grid.Column="1" Classes="session-label" Text="{Binding StationLabel}" ToolTip.Tip="{Binding StationLabel}"
                                 FontFamily="{DynamicResource Led.FontFamily}" FontSize="12" Margin="3,0,6,0"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Classes="session-status" Classes.waiting="{Binding IsWaiting}" Classes.idle="{Binding IsIdle}"
                                 Text="{Binding Status}" FontFamily="{DynamicResource Led.FontFamily}" FontSize="10.5"
                                 VerticalAlignment="Center" Margin="4,0,4,0" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ScrollViewer Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding ShowClearList}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SessionGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionDisplayGroupViewModel">
                <StackPanel Margin="6,0,6,4">
                  <Grid ColumnDefinitions="*,Auto" MinHeight="33" DataContext="{Binding Header}"
                        x:DataType="vm:SessionDisplayRowViewModel">
                    <Border Grid.ColumnSpan="2" Classes="session-completion" Classes.blink="{Binding IsDone}"
                            CornerRadius="6" Background="{DynamicResource Led.CompletionTint}" IsHitTestVisible="False" />
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="8,0,0,0">
                      <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource Led.SessionTitleBrush}"
                                 FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Row.Engine}" Foreground="{DynamicResource Led.DimBrush}" FontSize="11"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="session-status" Classes.idle="{Binding IsIdle}"
                               Classes.waiting="{Binding IsWaiting}" Text="{Binding Status}" FontSize="11"
                               Margin="6,0,8,0" VerticalAlignment="Center" />
                  </Grid>
                  <Border Height="1" Background="{DynamicResource Led.BorderBrush}" IsVisible="{Binding HasChildren}" />
                  <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding HasChildren}" Margin="2,5,2,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SessionDisplayRowViewModel">
                        <Border CornerRadius="5" Background="{DynamicResource Led.SessionChildBrush}" Margin="3,1,3,2">
                          <Grid ColumnDefinitions="*,Auto" MinHeight="32">
                            <Border Grid.ColumnSpan="2" Classes="session-completion" Classes.blink="{Binding IsDone}"
                                    CornerRadius="5" Background="{DynamicResource Led.CompletionTint}" IsHitTestVisible="False" />
                            <TextBlock Text="{Binding StationLabel}" ToolTip.Tip="{Binding StationLabel}" Margin="7,0,3,0"
                                       Foreground="{DynamicResource Led.ForegroundBrush}" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="session-status" Classes.waiting="{Binding IsWaiting}"
                                       Text="{Binding Status}" FontSize="10" Margin="2,0,6,0" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <Button Name="IslandToggle" IsVisible="{Binding IslandMode}" Height="{Binding IslandHeaderHeight}"
            Margin="3,2,3,0" Padding="10,0" VerticalAlignment="Top" HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
            Focusable="False" AutomationProperties.Name="Dynamic Island">
      <Button.Template>
        <ControlTemplate>
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Button.Template>
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <Image Source="/Assets/TaskbarLedMark.png" Width="19" Height="19" />
        <Border Name="IslandActivityBadge" Grid.Column="2" MinWidth="39" CornerRadius="8" Padding="5,2"
                VerticalAlignment="Center" Background="{DynamicResource Led.IslandBadgeBackground}">
          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="▸" FontSize="12" Foreground="{DynamicResource Led.IslandBadgeForeground}" />
            <TextBlock Text="{Binding IslandActivityCount}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource Led.IslandBadgeForeground}"
                       FontFamily="{DynamicResource Led.FontFamily}" />
          </StackPanel>
        </Border>
      </Grid>
    </Button>

    <Border Background="{DynamicResource Led.DotGridBrush}" CornerRadius="4" IsHitTestVisible="False" />

    <!-- Outline that blinks green while a finished session waits to be seen, amber when one waits for you. -->
    <Border Classes="halo" Classes.blink="{Binding IsBlinking}"
            CornerRadius="4" BorderThickness="1.5" IsHitTestVisible="False" />
    <Border Classes="halo attention" Classes.blink="{Binding NeedsAttention}"
            CornerRadius="4" BorderThickness="1.5" IsHitTestVisible="False" />
  </Panel>
</UserControl>
