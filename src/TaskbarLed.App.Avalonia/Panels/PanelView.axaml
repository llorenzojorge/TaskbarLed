<!--
  The panel's look on Avalonia: session tabs, feed line and timer, blinking outline.
  Mirrors src/TaskbarLed.App/Panels/PanelView.xaml (WPF). Colors come from the Led.* resources.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskbarLed.App.Avalonia.Presentation"
             xmlns:panels="using:TaskbarLed.App.Avalonia.Panels"
             x:Class="TaskbarLed.App.Avalonia.Panels.PanelView"
             x:DataType="vm:PanelViewModel">

  <UserControl.Styles>
    <!-- Hard on/off blink, like a real LED. -->
    <Style Selector=":is(Control).blink">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="49%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Border.tab">
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="Padding" Value="3,0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="{DynamicResource Led.ChannelOffBrush}" />
    </Style>
    <Style Selector="Border.tab TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Led.FontFamily}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Led.DimBrush}" />
    </Style>
    <Style Selector="Border.tab.running TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
    </Style>
    <Style Selector="Border.tab.completed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.DoneBrush}" />
    </Style>
    <Style Selector="Border.tab.awaiting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>
    <!-- Selected tab: lit outline, bold text. Declared after the status colors so it wins. -->
    <Style Selector="Border.tab.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Led.ForegroundBrush}" />
    </Style>
    <Style Selector="Border.tab.selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.tab.selected.awaiting">
      <Setter Property="BorderBrush" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>
    <Style Selector="Border.tab.selected.awaiting TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>

    <Style Selector="TextBlock.feed">
      <Setter Property="Foreground" Value="{DynamicResource Led.ForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.feed.attention">
      <Setter Property="Foreground" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>

    <Style Selector="Border.halo">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Led.DoneBrush}" />
    </Style>
    <Style Selector="Border.halo.attention">
      <Setter Property="BorderBrush" Value="{DynamicResource Led.AttentionBrush}" />
    </Style>
  </UserControl.Styles>

  <Panel Cursor="Hand">
    <Border CornerRadius="4" BorderThickness="1"
            Background="{DynamicResource Led.BackgroundBrush}"
            BorderBrush="{DynamicResource Led.BorderBrush}" />

    <Grid Margin="6,3,8,2" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
      <ItemsControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Channels}" ClipToBounds="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <panels:TabStripPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChannelViewModel">
            <Border Classes="tab"
                    Classes.running="{Binding IsRunning}"
                    Classes.completed="{Binding IsCompleted}"
                    Classes.awaiting="{Binding IsAwaiting}"
                    Classes.selected="{Binding IsSelected}"
                    Classes.blink="{Binding IsCompleted}">
              <!-- The status mark stays whole; the title gives way when the row is full. -->
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Margin="4,0,0,0" Text="{Binding Glyph}" />
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Grid.Row="1" Grid.Column="0" Classes="feed" Classes.attention="{Binding FeedIsAttention}"
                 Text="{Binding Feed}" VerticalAlignment="Center"
                 FontFamily="{DynamicResource Led.FontFamily}" FontSize="13" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis">
        <TextBlock.Effect>
          <DropShadowEffect Color="{DynamicResource Led.GlowColor}" BlurRadius="8" OffsetX="0" OffsetY="0" Opacity="0.75" />
        </TextBlock.Effect>
      </TextBlock>

      <!-- Prompt timer on the feed's line, so the tabs get the whole top row for chat titles. -->
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElapsedText}" VerticalAlignment="Center" Margin="10,0,0,0"
                 FontFamily="{DynamicResource Led.FontFamily}" FontSize="12" FontWeight="SemiBold"
                 Foreground="{DynamicResource Led.ForegroundBrush}" />
    </Grid>

    <!-- Outline that blinks green while a finished session waits to be seen, amber when one waits for you. -->
    <Border Classes="halo" Classes.blink="{Binding IsBlinking}"
            CornerRadius="4" BorderThickness="1.5" IsHitTestVisible="False" />
    <Border Classes="halo attention" Classes.blink="{Binding NeedsAttention}"
            CornerRadius="4" BorderThickness="1.5" IsHitTestVisible="False" />
  </Panel>
</UserControl>
